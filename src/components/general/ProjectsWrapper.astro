---
import type { IProjects } from "@types";
import ProjectCard from "./ProjectCard.astro";

const { projects } = Astro.props as IProjects;
---

<section class="projects section" id="projects">
  <div class="site-container">
    <header class="section-header">
      <p class="section-label">02. Work</p>
      <h2 class="section-title">Side projects</h2>
      <p class="section-sub">
        Things I build outside of work — full products from API to UI.
      </p>
    </header>

    <div class="projects-grid">
      {
        projects.map((project, index) => (
          <div class="project-wrapper" style={`--delay: ${index * 0.08}s`}>
            <ProjectCard projectDetail={project} />
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .section-header {
    margin-bottom: 1.75rem;
  }

  .section-sub {
    font-size: 1rem;
    color: #666;
    margin-top: 0.5rem;
    max-width: 28rem;
  }

  :global([data-theme="dark"]) .section-sub {
    color: #888;
  }

  .project-wrapper {
    opacity: 0;
    animation: fadeInUp 0.5s ease forwards;
    animation-delay: var(--delay);
    display: flex;
    flex-direction: column;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 768px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
